{
  "enabled": true,
  "version": 1,
  "boosts": {
    "maxActivePerMetric": 1
  },
  "templates": [
    {
      "id": "develop",
      "forEachBusiness": true,
      "skipBusinesses": [
        "farm",
        "fish_stall",
        "roastery"
      ],
      "chapter": 0,
      "title": "Develop {businessName}",
      "summary": "Run the basic line at {businessName} until it earns its advanced recipe.",
      "teaches": "Every business earns its advanced product by running its ordinary line first.",
      "appear": {
        "ownsBusiness": "{businessId}"
      },
      "objectives": [
        {
          "kind": "count",
          "counter": "sell:{good1}",
          "target": 20,
          "label": "Sell 20 {good1Name}"
        },
        {
          "kind": "count",
          "counter": "sell:{good2}",
          "target": 12,
          "label": "Sell 12 {good2Name}"
        }
      ],
      "rewards": [
        {
          "type": "unlock_recipe",
          "goodId": "{good3}"
        },
        {
          "type": "flag",
          "name": "business_developed:{businessId}"
        },
        {
          "type": "speed_perk",
          "goodId": "{good3}",
          "percent": 5
        }
      ]
    }
  ],
  "quests": [
    {
      "id": "first-crop",
      "chapter": 1,
      "title": "First Crop",
      "summary": "Your farm is open. Sell your first ten tomatoes.",
      "teaches": "A business produces goods, and goods become cash only when someone buys them.",
      "appear": {},
      "objectives": [
        {
          "kind": "count",
          "counter": "sell:farm_tomatoes",
          "target": 10,
          "label": "Sell 10 Tomatoes"
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 40
        },
        {
          "type": "supplies",
          "budget": 60
        }
      ]
    },
    {
      "id": "room-to-grow",
