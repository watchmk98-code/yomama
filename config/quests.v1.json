      "appear": {
        "afterQuests": [
          "first-crop"
        ]
      },
      "objectives": [
        {
          "kind": "count",
          "counter": "act:upgrade",
          "target": 1,
          "label": "Buy any upgrade"
        }
      ],
      "rewards": [
        {
          "type": "cash",
          "amount": 60
        }
      ]
    },
    {
