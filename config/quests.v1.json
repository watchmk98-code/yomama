{
  "enabled": true,
  "version": 1,
  "boosts": {
    "maxActivePerMetric": 1
  },
  "templates": [
    {
      "id": "develop",
      "forEachBusiness": true,
      "skipBusinesses": [
        "farm",
        "fish_stall",
        "roastery"
      ],
      "chapter": 0,
      "title": "Develop {businessName}",
      "summary": "Run the basic line at {businessName} until it earns its advanced recipe.",
      "teaches": "Every business earns its advanced product by running its ordinary line first.",
      "appear": {
        "ownsBusiness": "{businessId}"
      },
      "objectives": [
        {
          "kind": "count",
          "counter": "sell:{good1}",
          "target": 20,
          "label": "Sell 20 {good1Name}"
        },
        {
          "kind": "count",
          "counter": "sell:{good2}",
          "target": 12,
          "label": "Sell 12 {good2Name}"
        }
      ],
      "rewards": [
        {
          "type": "unlock_recipe",
          "goodId": "{good3}"
        },
        {
          "type": "flag",
          "name": "business_developed:{businessId}"
        },
        {
          "type": "speed_perk",
          "goodId": "{good3}",
          "percent": 5
        }
      ],
      "group": "Business development",
      "businesses": {
        "garage": {
          "title": "Back on the Road",
          "summary": "Clear a run of repairs and keep the parts shelf stocked to earn the custom-mods recipe.",
          "teaches": "A repair shop earns twice: once for the work, and once for the parts it fits while doing it.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:garage_repairs",
              "target": 20,
              "label": "Sell 20 Repairs"
            },
            {
              "kind": "count",
              "counter": "sell:garage_spare_parts",
              "target": 12,
              "label": "Sell 12 Spare Parts"
            }
          ]
        },
        "workshop": {
          "title": "Measure Twice",
          "summary": "Cut brackets for the trade counter and weld frames in the back to earn the machined-bolts recipe.",
          "teaches": "Brackets are quick and cheap, frames slow and dear. A workshop lives on the mix, not on one or the other.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:workshop_steel_brackets",
              "target": 18,
              "label": "Sell 18 Steel Brackets"
            },
            {
              "kind": "count",
              "counter": "produce:workshop_welded_frames",
              "target": 10,
              "label": "Make 10 Welded Frames"
            }
          ]
        },
        "solar_coop": {
          "title": "Power the Block",
          "summary": "Generate daytime power and bank some of it to earn the carbon-credits recipe.",
          "teaches": "Daylight is free but it does not last. Storing it is what makes it worth something after dark.",
          "objectives": [
            {
              "kind": "count",
              "counter": "produce:solar_coop_daytime_kwh",
              "target": 25,
              "label": "Make 25 Daytime kWh"
            },
            {
              "kind": "count",
              "counter": "sell:solar_coop_battery_storage",
              "target": 10,
              "label": "Sell 10 Battery Storage"
            }
          ]
        },
        "cannery": {
          "title": "Save the Harvest",
          "summary": "Put up canned goods and bottle sauce to earn the preserves recipe.",
          "teaches": "Preserving is how food keeps its value after the harvest is over and the price has dropped.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:cannery_canned_goods",
              "target": 15,
              "label": "Sell 15 Canned Goods"
            },
            {
              "kind": "count",
              "counter": "sell:cannery_sauces",
              "target": 10,
              "label": "Sell 10 Sauces"
            }
          ]
        },
        "machine_works": {
          "title": "Precision Work",
          "summary": "Machine parts for customers and tooling for yourself to earn the prototypes recipe.",
          "teaches": "Tooling is not for customers. It is what lets you make the next thing accurately, and it pays for itself later.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:machine_works_cnc_parts",
              "target": 12,
              "label": "Sell 12 CNC Parts"
            },
            {
              "kind": "count",
              "counter": "produce:machine_works_tooling",
              "target": 8,
              "label": "Make 8 Tooling"
            }
          ]
        },
        "turbine_field": {
          "title": "Catch the Wind",
          "summary": "Generate wind power and sign capacity contracts to earn the green-certificates recipe.",
          "teaches": "A capacity contract sells a promise to be available, not electricity you have already made.",
          "objectives": [
            {
              "kind": "count",
              "counter": "produce:turbine_field_wind_kwh",
              "target": 20,
              "label": "Make 20 Wind kWh"
            },
            {
              "kind": "count",
              "counter": "sell:turbine_field_capacity_contracts",
              "target": 8,
              "label": "Sell 8 Capacity Contracts"
            }
          ]
        },
        "generator": {
          "title": "Peak Hour",
          "summary": "Run steady power and cover the evening peak to earn the steam-heat recipe.",
          "teaches": "Steady power is cheap. Power at the exact hour everyone wants it is expensive. Same electricity.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:generator_baseload_power",
              "target": 12,
              "label": "Sell 12 Baseload Power"
            },
            {
              "kind": "count",
              "counter": "sell:generator_peak_power",
              "target": 6,
              "label": "Sell 6 Peak Power"
            }
          ]
        },
        "relay_station": {
          "title": "Dead Zone",
          "summary": "Carry bandwidth and route messages to earn the tower-leases recipe.",
          "teaches": "One tower can carry your own traffic and be rented to somebody else at the same time.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:relay_station_bandwidth",
              "target": 10,
              "label": "Sell 10 Bandwidth"
            },
            {
              "kind": "count",
              "counter": "produce:relay_station_sms_traffic",
              "target": 6,
              "label": "Make 6 SMS Traffic"
            }
          ]
        },
        "freight_terminal": {
          "title": "Loading Puzzle",
          "summary": "Fill container slots and run the cold chain to earn the last-mile recipe.",
          "teaches": "Cold cargo pays more because it is harder. You are charging for the refrigeration, not the distance.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:freight_terminal_container_slots",
              "target": 8,
              "label": "Sell 8 Container Slots"
            },
            {
              "kind": "count",
              "counter": "sell:freight_terminal_cold_storage",
              "target": 5,
              "label": "Sell 5 Cold Storage"
            }
          ]
        },
        "data_center": {
          "title": "Launch Day",
          "summary": "Sell compute time and provision storage to earn the API-calls recipe.",
          "teaches": "Compute is sold by the hour and spent. Storage is rented by the month and keeps earning. Both are the same racks.",
          "objectives": [
            {
              "kind": "count",
              "counter": "produce:data_center_compute_hours",
              "target": 10,
              "label": "Make 10 Compute Hours"
            },
            {
              "kind": "count",
              "counter": "sell:data_center_cloud_storage",
              "target": 5,
              "label": "Sell 5 Cloud Storage"
            }
          ]
        },
        "solar_array": {
          "title": "Panel Plan",
          "summary": "Supply the grid and hold capacity in reserve to earn the renewable-credits recipe.",
          "teaches": "Reserve capacity earns whether or not anyone uses it. That is exactly why it is worth more than the power.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:solar_array_utility_kwh",
              "target": 6,
              "label": "Sell 6 Utility kWh"
            },
            {
              "kind": "count",
              "counter": "sell:solar_array_reserve_capacity",
              "target": 4,
              "label": "Sell 4 Reserve Capacity"
            }
          ]
        },
        "uplink_center": {
          "title": "Launch Window",
          "summary": "Route satellite bandwidth and book ground time to earn the telemetry recipe.",
          "teaches": "A ground station can only talk to a satellite while it is overhead. The window itself is the product.",
          "objectives": [
            {
              "kind": "count",
              "counter": "sell:uplink_center_satellite_bandwidth",
              "target": 5,
              "label": "Sell 5 Satellite Bandwidth"
            },
            {
              "kind": "count",
              "counter": "sell:uplink_center_ground_time",
              "target": 3,
              "label": "Sell 3 Ground Time"
            }
          ]
        }
      }
    }
  ],
